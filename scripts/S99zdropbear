#!/bin/sh
DB=/data/opt/bin/dropbear
DBKEY=/data/opt/bin/dropbearkey
DIR=/data/opt/etc/dropbear
HK=$DIR/hk_ed25519
LOG=$DIR/dropbear.log
start() {
  [ -x "$DB" ] || return 1
  [ -s "$HK" ] || "$DBKEY" -t ed25519 -f "$HK" >>"$LOG" 2>&1 || return 1
  pidof dropbear >/dev/null 2>&1 && return 0
  "$DB" -s -D "$DIR" -r "$HK" -p 2222 >>"$LOG" 2>&1 &
  sleep 1
  pidof dropbear >/dev/null 2>&1
}
case "$1" in
  start) start ;;
  stop) killall dropbear 2>/dev/null ;;
  restart) killall dropbear 2>/dev/null; sleep 1; start ;;
esac
exit 0
